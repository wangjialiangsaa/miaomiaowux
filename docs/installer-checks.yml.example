name: Installer checks
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - run: node scripts/build.mjs --check
      - run: bash -n install.sh && bash -n upgrade-agent.sh
      - run: sudo python3 -m unittest discover -s tests -v

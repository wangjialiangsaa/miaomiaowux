#!/usr/bin/env bash
# Generated by node scripts/build.mjs. Edit scripts/*.in and common.sh instead.
set -Eeuo pipefail
umask 077
REPO="${MMWX_REPO:-zako-li/miaomiaowux}"
TAG_MATCH='^(mmwx-agent|mmwx-agent-v[0-9A-Za-z._-]+)$'
ASSET_BASE=mmwx-agent-linux
PREFIX=/usr/local SERVICE=mmw-agent UNIT_DIR="${MMWX_UNIT_DIR:-/etc/systemd/system}"
WANT_TAG='' LOCAL_BINARY='' EXPECTED_SHA='' HEALTH_URL='' HEALTH_TIMEOUT=30
usage() {
    printf '%s\n' '用法：bash upgrade-agent.sh [--version TAG | --binary FILE --sha256 HASH]' \
      '可选：--prefix DIR --service NAME --health-url http://127.0.0.1:PORT/path --health-timeout 30' \
      '保留 Agent 配置和 xray；支持 systemd / OpenRC，原来停止的服务保持停止。'
}
# @COMMON@
while (( $# )); do
    case "$1" in
        --version|--binary|--sha256|--prefix|--service|--health-url|--health-timeout)
            value_required "$@"
            case "$1" in
                --version) WANT_TAG="$2";; --binary) LOCAL_BINARY="$2";; --sha256) EXPECTED_SHA="$2";;
                --prefix) PREFIX="${2%/}";; --service) SERVICE="$2";; --health-url) HEALTH_URL="$2";; --health-timeout) HEALTH_TIMEOUT="$2";;
            esac
            shift 2;;
        -h|--help) usage; exit 0;; *) die "未知参数：$1";;
    esac
done
validate_options
BIN_PATH="$PREFIX/bin/mmw-agent"
[[ -f "$BIN_PATH" ]] || die '没有已安装的 Agent，请先使用面板生成的安装命令'
case "${MMWX_INIT:-auto}" in auto|systemd|openrc) :;; *) die 'MMWX_INIT 应为 auto / systemd / openrc';; esac
INIT=''
if [[ "${MMWX_INIT:-auto}" != openrc ]]; then
    if command -v systemctl >/dev/null && systemctl show-environment >/dev/null 2>&1; then
        load_state="$(systemctl show "$SERVICE" --property=LoadState --value)" || die '无法查询 systemd 服务，未替换程序'
        [[ "$load_state" == loaded ]] || die 'systemd 未加载此 Agent 服务，未替换程序'
        INIT=systemd
    elif [[ -d /run/systemd/system || "${MMWX_INIT:-auto}" == systemd ]]; then die 'systemd 状态查询失败，未替换程序'; fi
fi
if [[ -z "$INIT" ]]; then
    command -v rc-service >/dev/null && rc-service --exists "$SERVICE" || die '没有可管理的 systemd / OpenRC 服务，未替换程序'
    INIT=openrc
fi
begin_update
finish_update

#!/usr/bin/env bash
# Generated by node scripts/build.mjs. Edit scripts/*.in and common.sh instead.
set -Eeuo pipefail
umask 077
REPO="${MMWX_REPO:-zako-li/miaomiaowux}"
TAG_MATCH='^(mmwx|mmwx-v[0-9A-Za-z._-]+)$'
ASSET_BASE=mmwx-linux
PREFIX=/usr/local SERVICE=mmwx UNIT_DIR="${MMWX_UNIT_DIR:-/etc/systemd/system}"
ACTION=install PORT='' DATA_DIR='' WANT_TAG='' LOCAL_BINARY='' EXPECTED_SHA='' HEALTH_URL='' HEALTH_TIMEOUT=30
usage() {
    printf '%s\n' '用法：bash install.sh [install|update|uninstall] [参数]' \
      '  --port 12889 --data-dir /etc/mmwx/data（仅首次安装）' \
      '  --version TAG 或 --binary FILE --sha256 HASH' \
      '  --prefix /opt/mmwx-test --service mmwx-test（独立测试实例）' \
      '  --health-url http://127.0.0.1:12889/login --health-timeout 30' \
      '脚本仓库：wangjialiangsaa/miaomiaowux；二进制默认来源：zako-li/miaomiaowux'
}
# @COMMON@
while (( $# )); do
    case "$1" in
        install|update|uninstall) ACTION="$1"; shift;;
        upgrade) ACTION=update; shift;; remove) ACTION=uninstall; shift;;
        --port|--data-dir|--version|--binary|--sha256|--prefix|--service|--health-url|--health-timeout)
            value_required "$@"
            case "$1" in
                --port) PORT="$2";; --data-dir) DATA_DIR="$2";; --version) WANT_TAG="$2";;
                --binary) LOCAL_BINARY="$2";; --sha256) EXPECTED_SHA="$2";; --prefix) PREFIX="${2%/}";;
                --service) SERVICE="$2";; --health-url) HEALTH_URL="$2";; --health-timeout) HEALTH_TIMEOUT="$2";;
            esac
            shift 2;;
        -h|--help) usage; exit 0;; *) die "未知参数：$1";;
    esac
done
validate_options
if [[ -n "$PORT" ]]; then
    [[ "$PORT" =~ ^[0-9]+$ && ${#PORT} -le 5 ]] || die '--port 应为 1–65535'
    PORT=$((10#$PORT)); (( PORT >= 1 && PORT <= 65535 )) || die '--port 应为 1–65535'
fi
if [[ -z "$DATA_DIR" ]]; then
    if [[ "$PREFIX" == /usr/local ]]; then DATA_DIR=/etc/mmwx/data; else DATA_DIR="$PREFIX/data"; fi
fi
safe_path "$DATA_DIR"
command -v systemctl >/dev/null && systemctl show-environment >/dev/null || die '面板安装需要运行中的 systemd；OpenRC 目前仅支持 Agent 升级'
INIT=systemd
BIN_PATH="$PREFIX/bin/mmwx" UNIT_PATH="$UNIT_DIR/$SERVICE.service"
load_state="$(systemctl show "$SERVICE" --property=LoadState --value)" || die '无法查询 systemd 服务，未修改程序'
case "$load_state" in
    loaded) [[ -f "$UNIT_PATH" && ! -L "$UNIT_PATH" ]] || die '已有服务位于其他目录，请确认服务路径；不覆盖现有配置';;
    not-found) [[ ! -e "$UNIT_PATH" && ! -L "$UNIT_PATH" ]] || die '服务文件存在但尚未被 systemd 正确加载，请先检查';;
    *) die '服务已屏蔽或加载异常，未修改程序';;
esac
if [[ "$ACTION" == uninstall ]]; then
    lock_update
    if [[ "$load_state" == loaded ]]; then
        svc stop
        initial_state
        (( WAS_RUNNING == 0 )) || die '服务仍在运行，未卸载'
        systemctl disable "$SERVICE"
        rm -f -- "$UNIT_PATH"
        systemctl daemon-reload
    fi
    rm -f -- "$BIN_PATH"
    info '程序和服务已卸载；数据目录及 .previous 备份保留'
    exit 0
fi
NEW_UNIT=0
if [[ "$load_state" == not-found ]]; then
    NEW_UNIT=1; PORT="${PORT:-12889}"
    [[ -n "$HEALTH_URL" ]] || HEALTH_URL="http://127.0.0.1:$PORT/login"
else
    [[ -z "$PORT" ]] || warn '已有服务配置，忽略 --port'
    # Effective environment includes systemd drop-ins. Do not print credentials.
    if [[ -z "$HEALTH_URL" ]]; then
        environment="$(systemctl show "$SERVICE" --property=Environment --value)"
        effective_port="$(printf '%s' "$environment" | python3 -c 'import shlex,sys; print(next((v[5:] for v in shlex.split(sys.stdin.read()) if v.startswith("PORT=")), ""))')"
        if [[ "$effective_port" =~ ^[0-9]{1,5}$ ]]; then HEALTH_URL="http://127.0.0.1:$effective_port/login";
        else warn '未识别现有监听端口，只检查服务状态；可显式设置 --health-url'; fi
    fi
fi
command -v curl >/dev/null || die '健康检查需要 curl'
begin_update
if (( NEW_UNIT )); then
    mkdir -p -- "$DATA_DIR/agent-bin" "$UNIT_DIR"
    env_escape() { local v="$1"; v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; printf '%s' "${v//%/%%}"; }
    {
        printf '[Unit]\nDescription=MiaomiaowuX Panel\nAfter=network.target\n\n[Service]\nType=simple\nExecStart=%s\n' "$BIN_PATH"
        printf 'WorkingDirectory="%s"\nEnvironment="PORT=%s"\nEnvironment="MMWX_DATA_DIR=%s"\n' "$(env_escape "$DATA_DIR")" "$PORT" "$(env_escape "$DATA_DIR")"
        if [[ -n "${MMWX_GH_PROXY:-}" ]]; then printf 'Environment="MMWX_GH_PROXY=%s"\n' "$(env_escape "$MMWX_GH_PROXY")"; fi
        printf 'Restart=on-failure\nRestartSec=5\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n'
    } > "$STAGING/new-unit"
    CREATED_UNIT=1
    install -m 0644 "$STAGING/new-unit" "$UNIT_PATH"
    systemctl daemon-reload
fi
finish_update
info '面板入口为 /login；浏览器请使用 HTTPS 或 localhost / SSH 隧道'
